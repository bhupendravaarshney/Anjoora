# Server-only AnjooraOps origin. Do not use a NEXT_PUBLIC variable.
# Run AnjooraOps on port 3000 and the Anjoora frontend on another port locally.
ANJOORA_OPS_API_URL=http://localhost:3000
ANJOORA_INTEGRATION_SECRET=replace-with-the-same-long-secret-configured-in-anjoora-ops
# Optional anti-bot verification
# TURNSTILE_SECRET_KEY=
