# Server-only ANJOORA Ops origin. Do not use a NEXT_PUBLIC variable.
# Run ANJOORA Ops on port 3000 and the ANJOORA frontend on another port locally.
GO_LIVE=false
ANJOORA_OPS_URL=http://localhost:3000
ANJOORA_INTEGRATION_SECRET=replace-with-the-same-long-secret-configured-in-anjoora-ops
# Optional anti-bot verification
# TURNSTILE_SECRET_KEY=
